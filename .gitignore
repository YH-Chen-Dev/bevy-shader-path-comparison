# Generated by Cargo
# will have compiled files and executables
/target/
/wgsl-material-path/target/
/rust-gpu-plugin-path/bevy-app/target/
/rust-gpu-plugin-path/rust-gpu/target/

# Generated Rust-GPU runtime artifacts
/rust-gpu-plugin-path/bevy-app/assets/rust-gpu/
/rust-gpu-plugin-path/bevy-app/generated/

# Generated Rust-GPU SPIR-T pass dumps
/rust-gpu-plugin-path/rust-gpu/spirt-passes/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Local editor and OS files
.vscode/
.DS_Store

# RustRover / JetBrains
# Prefer configuring JetBrains files in a global gitignore.
#.idea/
